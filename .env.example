# AI Token Export / Routing Gateway
# Environment configuration

# App
APP_NAME=token-gateway
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Database (SQLite dev; swap to Postgres in prod)
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# Redis (rate limiting / caching / token counters)
REDIS_URL=redis://localhost:6379/0
# If no Redis available, set REDIS_FALLBACK_INMEMORY=true
REDIS_FALLBACK_INMEMORY=true

# Auth
JWT_SECRET=change-me-in-prod-please-32bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_PREFIX=tg_

# Upstream providers (comma-separated base URLs)
# DeepSeek, Qwen (DashScope), OpenAI, Anthropic, Baichuan
UPSTREAM_DEEPSEEK=https://api.deepseek.com
UPSTREAM_QWEN=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_OPENAI=https://api.openai.com/v1
UPSTREAM_ANTHROPIC=https://api.anthropic.com/v1
UPSTREAM_BAICHUAN=https://api.baichuan-ai.com/v1

# Upstream provider credentials (required for real model calls).
# The gateway injects these server-side; tenant API keys are never forwarded
# upstream. Leave empty to get a 503 with instructions instead of a confusing
# 401 from the provider.
UPSTREAM_API_KEY_DEEPSEEK=
UPSTREAM_API_KEY_QWEN=
UPSTREAM_API_KEY_OPENAI=
UPSTREAM_API_KEY_ANTHROPIC=
UPSTREAM_API_KEY_BAICHUAN=

# Cross-border / PII
PII_MASKING_ENABLED=true
PII_MASK_CHAR=*

# Billing
BILLING_WEBHOOK_URL=
USAGE_FLUSH_INTERVAL_SEC=10

# Rate limits (defaults; per-tenant override in DB)
DEFAULT_RPM=60
DEFAULT_TPM=100000

# Admin API (gate /admin/*). Required in prod; dev default below.
ADMIN_API_KEY=dev-admin-key-change-me
CORS_ORIGINS=*

# Trusted proxies (comma-separated) whose X-Forwarded-For is honored
TRUSTED_PROXIES=

# Max request body size in bytes
MAX_REQUEST_BODY_BYTES=1048576

QUOTA_ENFORCEMENT_ENABLED=true

# Fire a cap_alert billing event (DB + BILLING_WEBHOOK_URL) once per tenant per
# day when today's tokens reach this share of the daily cap. 0 disables it.
CAP_ALERT_THRESHOLD=0.8
